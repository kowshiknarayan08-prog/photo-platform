# ---------------------------------------------------------------------------
# Server configuration. Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# HTTP port the API listens on
PORT=4000

# Node environment: development | production | test
NODE_ENV=development

# Comma-separated list of origins allowed to call the API (the frontend URL).
# For local dev the Vite server runs on 5173.
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Database (PostgreSQL). Get this connection string from Supabase:
#   Project Settings -> Database -> Connection string -> "URI"
# Example: postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/photo_platform?schema=public"

# ---------------------------------------------------------------------------
# JWT signing secret. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN=7d

# Short-lived token issued to customers after they enter the correct gallery PIN
GALLERY_TOKEN_EXPIRES_IN=2h

# ---------------------------------------------------------------------------
# File storage driver: "local" (writes to ./uploads, good for development)
#                   or "supabase" (Supabase Storage bucket, used in production)
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local

# Only needed when STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=uploads
# Public base URL the API is reachable at (used to build local file URLs)
PUBLIC_API_URL=http://localhost:4000

# Only needed when STORAGE_DRIVER=supabase
SUPABASE_URL=
# Use the SERVICE ROLE key (server-side only, keep secret)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=photos

# Upload limits
MAX_UPLOAD_MB=15
MAX_FILES_PER_UPLOAD=20
